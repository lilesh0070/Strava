{
  "expo": {
    "name": "TBDI FitTrack",
    "slug": "stride",
    "scheme": "stride",
    "version": "1.3.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E9EDF3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lilesh.stride",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lilesh.stride",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TBDI FitTrack uses your location to record your route while an activity is running, even when the screen is off.",
          "locationWhenInUsePermission": "TBDI FitTrack uses your location to record your route.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "TBDI FitTrack uses your location to record your route while an activity is running, even when the screen is off.",
          "locationFullAccuracyPermission": "TBDI FitTrack needs your precise location to measure your route and distance accurately."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "TBDI FitTrack uses your photos to put your route and stats on top of them for sharing.",
          "cameraPermission": "TBDI FitTrack uses the camera to take a photo for your activity story.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "TBDI FitTrack counts your steps during walks and runs."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TBDI FitTrack saves your activity stickers and stories to your gallery.",
          "savePhotosPermission": "TBDI FitTrack saves your activity stickers and stories to your gallery.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAsyncStorageSize",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E9EDF3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#262A31"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "updateRepo": "lilesh0070/strava",
      "firebase": {
        "apiKey": "AIzaSyCmWgSnBdUQerKmM0mcf3xlqHcdmTAmXoQ",
        "projectId": "stribe-a8108"
      },
      "facebookAppId": ""
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
